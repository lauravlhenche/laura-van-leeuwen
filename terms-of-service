        :root {
            --navy: #101828;
            --blue: #245cff;
            --yellow: #ffc83d;
            --cream: #f7f1e8;
            --white: #ffffff;
            --text: #344054;
            --muted: #667085;
            --border: #d8dee8;
            --soft-border: #e4e7ec;
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            color: var(--text);
            background: var(--white);
            font-family: "Inter", Arial, sans-serif;
            font-size: 1rem;
            line-height: 1.7;
            -webkit-font-smoothing: antialiased;
        }

        a {
            color: var(--blue);
            overflow-wrap: anywhere;
        }

        a:focus-visible {
            outline: 3px solid var(--blue);
            outline-offset: 4px;
            border-radius: 3px;
        }

        /* HEADER */

        .site-header {
            color: var(--white);
            background: var(--navy);
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .site-header-inner {
            width: min(900px, calc(100% - 40px));
            min-height: 96px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 28px;
        }

        .brand,
        .footer-brand {
            min-width: 0;
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: var(--white);
            text-decoration: none;
        }

        .brand-logo,
        .footer-logo {
            width: 54px;
            height: 54px;
            flex: 0 0 54px;
            display: block;
            object-fit: contain;
        }

        .brand-name {
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            font-family: "Plus Jakarta Sans", Arial, sans-serif;
            white-space: nowrap;
        }

        .brand-name-main {
            color: var(--white);
            font-size: 1.14rem;
            font-weight: 700;
            line-height: 1.05;
            letter-spacing: -0.045em;
        }

        .brand-name-first {
            margin-top: 5px;
            color: var(--yellow);
            font-size: 0.7rem;
            font-weight: 700;
            line-height: 1;
            letter-spacing: 0.16em;
            text-transform: uppercase;
        }

        .site-nav,
        .footer-nav {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .site-nav a,
        .footer-nav a {
            min-height: 44px;
            padding: 0 22px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: var(--blue);
            background: var(--white);
            border: 1px solid var(--white);
            border-radius: 999px;
            font-size: 0.86rem;
            font-weight: 700;
            line-height: 1;
            text-decoration: none;
            transition:
                color 0.2s ease,
                background-color 0.2s ease,
                border-color 0.2s ease,
                box-shadow 0.2s ease,
                transform 0.2s ease;
        }

        .site-nav a:hover,
        .footer-nav a:hover {
            color: var(--white);
            background: var(--blue);
            border-color: var(--blue);
            box-shadow: 0 8px 20px rgba(36, 92, 255, 0.28);
            transform: translateY(-1px);
        }

