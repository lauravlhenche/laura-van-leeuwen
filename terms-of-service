            }

            .policy-card {
                padding: 40px 28px;
                border-radius: 18px;
            }

            .site-footer {
                padding: 40px 20px 22px;
            }

            .site-footer-inner {
                flex-direction: column;
                align-items: flex-start;
                gap: 28px;
            }

            .footer-nav {
                flex-wrap: wrap;
            }

            .site-footer-bottom {
                flex-direction: column;
                align-items: flex-start;
                gap: 12px;
            }

            .site-footer-copyright {
                white-space: normal;
            }
        }

        @media (max-width: 520px) {
            .site-header .brand-name {
                display: none;
            }

            .site-nav a {
                min-height: 36px;
                padding: 0 9px;
                font-size: 0.7rem;
            }

            .policy-section {
                padding-right: 16px;
                padding-left: 16px;
            }

            .policy-card {
                padding: 30px 21px;
            }

            .policy-introduction,
            .contact-details {
                padding: 18px;
            }
        }

        @media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *,
            *::before,
            *::after {
                transition: none !important;
            }
        }

        @media print {
            .site-header,
            .site-footer,
            .back-home {
                display: none;
            }

            .policy-hero,
            .policy-section {
                padding: 24px 0;
                background: var(--white);
            }

            .policy-card {
                width: 100%;
                padding: 0;
                border: 0;
                box-shadow: none;
            }
        }
    </style>
</head>

