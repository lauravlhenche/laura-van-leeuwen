            background: #f8fafc;
            border: 1px solid var(--soft-border);
            border-radius: 14px;
        }

        .contact-details p {
            margin: 0;
        }

        .contact-details p + p {
            margin-top: 7px;
        }

        .back-home {
            margin: 28px auto 0;
            text-align: center;
        }

        .back-home a {
            color: var(--navy);
            font-size: 0.9rem;
            font-weight: 700;
            text-decoration: none;
        }

        .back-home a:hover {
            color: var(--blue);
        }

        /* FOOTER */

        .site-footer {
            padding: 46px 28px 24px;
            color: var(--white);
            background: var(--navy);
        }

        .site-footer-inner,
        .site-footer-bottom {
            width: min(1050px, 100%);
            margin: 0 auto;
        }

        .site-footer-inner {
            padding-bottom: 34px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 40px;
        }

        .site-footer-main {
