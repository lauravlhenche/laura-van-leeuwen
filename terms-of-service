            flex-direction: column;
            align-items: flex-start;
            gap: 13px;
        }

        .site-footer-description {
            max-width: 380px;
            margin: 0;
            color: #aeb9cc;
            font-size: 0.82rem;
            line-height: 1.55;
        }

        .site-footer-location {
            color: #8f9bad;
            font-size: 0.77rem;
            line-height: 1.5;
        }

        .site-footer-location a,
        .site-footer-legal a {
            color: #d5dbe5;
            font-weight: 600;
            text-decoration: none;
        }

        .site-footer-location a:hover,
        .site-footer-legal a:hover {
            color: var(--white);
